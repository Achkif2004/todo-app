# Extra beveiliging: nooit scripts uitvoeren vanuit de uploads-map.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:php[0-9]?|phtml|phar|phps|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(?i:php[0-9]?|phtml|phar|phps|cgi|pl|py|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
